# Copie para .env e preencha. O .env não vai para o GitHub.

PORT=3333

# só esse endereço pode chamar a API
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=desapegauai

# obrigatório; cada um gera o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGREDO=

# ID do cliente OAuth do Google (o mesmo do front)
GOOGLE_CLIENT_ID=

# login de teste (POST /api/auth/teste); nunca funciona em produção
PERMITIR_LOGIN_TESTE=true

# Notificação push no celular e no computador. Gere as duas chaves com:
#   npx web-push generate-vapid-keys
# A pública também vai para o front. Sem elas, os avisos só aparecem com o site aberto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contato do responsável pelo site (mailto: ou https:)
VAPID_CONTATO=

# Rua exata pela localização usa o OpenStreetMap (Nominatim). false = só a base do IBGE.
GEOCODIFICACAO_EXTERNA=true

# true = mostra cada requisição no terminal (sem dados pessoais)
LOG_REQUISICOES=false
