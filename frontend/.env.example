# Copie este arquivo para .env se precisar mudar alguma configuração.
# Em desenvolvimento não precisa preencher nada: o Vite já manda o /api para http://localhost:3333.

# Endereço da API em produção (ex.: https://api.desapegauai.com.br). Deixe vazio no seu computador.
VITE_API_URL=

# Código do Google para o botão "Entrar com o Google".
# É o mesmo valor do GOOGLE_CLIENT_ID que está no backend/.env. Ele termina em .apps.googleusercontent.com
# Depois de mudar o .env, pare o npm run dev e rode de novo.
VITE_GOOGLE_CLIENT_ID=
